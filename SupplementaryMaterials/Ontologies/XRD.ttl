    obo:BFO_0000056 mds:XrayRecipe_1 ;
    obo:BFO_0000171 mds:CHESS_F2_Current ;
    cco:ont00001879 mds:CHESS_F2_ToolID_Content .

mds:CHESS_Facility a mds:CHESS ;
    obo:BFO_0000171 mds:Cornell_Site ;
    cco:ont00001879 mds:CHESS_Facility_Content .

mds:CarbonFilterPosition_1 a mds:CarbonFilterPosition .

mds:CaveSlit a owl:Class ;
    rdfs:label "Cave Slit"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A precision aperture device that defines and controls the cross-sectional area of an X-ray beam in a beamline hutch or cave." .

mds:CaveSlit_1 a mds:CaveSlit ;
    obo:BFO_0000171 mds:BottomCaveSlitPosition_1,
        mds:HorizontalCaveSlitPosition_1,
        mds:TopCaveSlitPosition_1 .

mds:ChemicalFormula a owl:Class ;
    rdfs:label "ChemicalFormula" ;
    rdfs:subClassOf cco:ont00000686 ;
    skos:definition "Chemical composition of the material." .

mds:ChiDiscontinuity a owl:Class ;
    rdfs:label "ChiDiscontinuity" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:altLabel "chi_discontinuity" ;
    skos:definition "The position of the discontinuity of the chi axis between 0 and 2π." .

mds:ColumnarMorphology a owl:Class ;
    rdfs:label "Columnar Morphology"@en ;
    rdfs:subClassOf mds:GrainMorphology ;
    skos:definition "A grain morphology in which grains are elongated along the direction of heat extraction, characteristic of directional solidification. In LPBF Ti-6Al-4V, prior beta grains are columnar along the build direction."@en .

mds:ContinuousCoolingTransformation a owl:Class ;
    rdfs:label "Continuous Cooling Transformation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom mds:Sample ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf cco:ont00001808 ] ;
            owl:someValuesFrom cco:ont00000965 ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf cco:ont00001808 ] ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( cco:ont00000965 [ a owl:Restriction ;
                                owl:onProperty cco:ont00001808 ;
                                owl:someValuesFrom mds:CoolingRate ] ) ] ],
        obo:BFO_0000015 ;
    skos:definition "A heat treatment process where the material is cooled continuously at a controlled rate, allowing phase transformation during cooling."@en .

mds:CoolingSegment a owl:Class ;
    rdfs:label "Cooling Segment"@en ;
    rdfs:subClassOf mds:ThermalCycleSegment ;
    skos:definition "A segment of a thermal cycle during which temperature is decreased."@en .

mds:CrystalStructure a owl:Class ;
    rdfs:label "Crystal Structure"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

mds:DEX a mds:DetectorManufacturer ;
    rdfs:label "DEX" .

mds:DXR250RTPlus a owl:Class ;
    rdfs:label "2304871 (DXR-250RT+)" ;
    rdfs:subClassOf mds:XrayDetector .

