mds:HyperparameterConfiguration a owl:Class ;
    rdfs:label "Hyperparameter Configuration"@en ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the set of hyperparameter values governing a neural network training process."@en .

mds:IntegrationID a owl:Class ;
    rdfs:label "integrationID" ;
    rdfs:subClassOf cco:ont00000077 ;
    skos:definition " A unique identifier for a specific integration operation, allowing tracking and referencing of individual integration processes." .

mds:IntegrationOptions a owl:Class ;
    rdfs:label "Integration Configuration"@en ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the parameters controlling the behaviour of an azimuthal integration algorithm."@en .

mds:IsothermalHoldTemperature a owl:Class ;
    rdfs:label "Isothermal Hold Temperature"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf cco:ont00001808 ] ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( cco:ont00001163 [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000084 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( cco:ont00000253 [ a owl:Restriction ;
                                                    owl:onProperty cco:ont00001769 ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:decimal ;
                                                            owl:withRestrictions ( [ xsd:minInclusive 600.0 ] [ xsd:maxInclusive 1000.0 ] ) ] ] ) ] ] ) ] ],
        cco:ont00000441 ;
    skos:definition "The constant temperature maintained during an isothermal hold segment of heat treatment."@en .

mds:LearningRateSpecification a owl:Class ;
    rdfs:label "Learning Rate Specification"@en ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the step size applied to parameter updates during optimisation."@en .

mds:MaiaDetector a owl:Class ;
    rdfs:label "Maia" ;
    rdfs:subClassOf mds:XrayDetector .

mds:MethodOfIntegration a owl:Class ;
    rdfs:label "MethodOfIntegration" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:altLabel "method" ;
    skos:definition "The computational algorithm used for integration." .

mds:Microstrain a owl:Class ;
    rdfs:label "Lattice Microstrain"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

mds:ModelValidationProcess a owl:Class ;
