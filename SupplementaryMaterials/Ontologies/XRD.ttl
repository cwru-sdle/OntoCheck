<https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html> a owl:Ontology ;
    rdfs:label "MDS Synchrotron X-ray Ontology"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "A BFO- and CCO-conformant ontology for in situ synchrotron X-ray diffraction experiments on additively manufactured alloys, covering beamline instrumentation, thermal processing, Rietveld refinement outputs, and neural network modelling processes."@en ;
    owl:imports obo:bfo.owl,
        cco:CommonCoreOntologiesMerged ;
    owl:versionIRI <https://cwrusdle.bitbucket.io/files/MDS_Onto/4.0.0/index-en.html> ;
    owl:versionInfo "4.0.0" .

