    owl:members ( mds:AzimuthalIntegration mds:DarkCorrection mds:SyncXrayPreProcessing ) .

[] a owl:AllDisjointClasses ;
    owl:members ( mds:AzimuthalRange mds:ChiDiscontinuity mds:ErrorModel mds:MethodOfIntegration mds:NumberOfPointsAzimuth mds:NumberOfPointsRadial mds:PolarizationCorrection mds:PolarizationFactor mds:RadialRange mds:RemoveNaN mds:SolidAngleCorrection mds:UnitOfIntegration ) .

[] a owl:AllDisjointClasses ;
    owl:members ( mds:IntegrationID mds:IntegrationOptions mds:IntegratedDiffractionPattern ) .

[] a owl:AllDisjointClasses ;
    owl:members ( mds:PONIFile mds:IntegratedDiffractionPattern ) .

[] a owl:AllDisjointClasses ;
    owl:members ( mds:BackpropagationProcess mds:ModelInferenceProcess mds:ModelTestingProcess mds:ModelValidationProcess mds:NeuralNetworkModelingProcess mds:NeuralNetworkTrainingProcess mds:TrainingEpoch ) .

[] a owl:AllDisjointClasses ;
    owl:members ( mds:BatchSizeSpecification mds:EpochCountSpecification mds:HyperparameterConfiguration mds:LearningRateSpecification ) .

[] a owl:AllDisjointClasses ;
    owl:members ( mds:ToolID mds:SyncXrayTool mds:SynchrotronFacility mds:Beamline ) .

[] a owl:AllDisjointClasses ;
    owl:members ( mds:DataPreprocessingOutput mds:ModelWeightsSpecification mds:NeuralNetworkArchitectureSpecification mds:NeuralNetworkTrainingFramework mds:PredictionOutput mds:TestDatasetSpecification mds:TrainedNeuralNetworkModel mds:TrainingDatasetSpecification mds:ValidationDatasetSpecification ) .

[] a owl:AllDisjointClasses ;
    owl:members ( mds:TrainingLossSpecification mds:ValidationAccuracySpecification ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Solid-state transformation mechanisms are mutually exclusive: a specific transformation event is governed by one mechanism."@en ;
    owl:members ( mds:DiffusionalTransformation mds:MartensisiticTransformation mds:MassiveTransformation mds:DiffusionalDisplaciveTransformation ) .

[] a owl:AllDisjointClasses ;
    owl:members ( mds:DetectorManufacturer mds:DetectorManufacturing mds:XrayDetector ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Solidification regimes are mutually exclusive."@en ;
    owl:members ( mds:RapidSolidification mds:EquilibriumSolidification ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Nucleation mechanisms are mutually exclusive. EpitaxialNucleation is a subclass of HeterogeneousNucleation and inherits this disjointness."@en ;
    owl:members ( mds:HomogeneousNucleation mds:HeterogeneousNucleation ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Grain morphology types are mutually exclusive as descriptions of the dominant morphological character."@en ;
    owl:members ( mds:EquiaxedMorphology mds:ColumnarMorphology mds:AcicularMorphology mds:LamellarMorphology mds:BasketweaveMorphology mds:BimodalMorphology mds:WidmanstattenMorphology ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Dislocation processes are mutually exclusive."@en ;
    owl:members ( mds:DislocationAnnihilation mds:DislocationMultiplication ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Thermal dimensional processes are mutually exclusive."@en ;
    owl:members ( mds:ThermalExpansion mds:ThermalContraction ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Disposition types are mutually exclusive."@en ;
    owl:members ( mds:TransformationSusceptibility mds:HardenabilityDisposition mds:RecrystallizationDisposition ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Manufacturing process types are mutually exclusive."@en ;
    owl:members ( mds:LaserPowderBedFusion mds:ElectronBeamMelting mds:DirectedEnergyDeposition mds:WroughtProcessing ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Strain/stress types are mutually exclusive as components of a decomposition."@en ;
    owl:members ( mds:IntergranularResidualStress mds:ChemicalStrain mds:ThermalStrain ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Information content entity types are mutually exclusive."@en ;
    owl:members ( mds:TTTDiagram mds:CCTDiagram mds:OrientationDistributionFunction mds:EquilibriumPhaseDiagram mds:ThermalProfile ) .

[] a owl:AllDisjointClasses ;
    owl:members ( mds:AndorNeo mds:Dexela2923 mds:DXR250RTPlus mds:Eiger1M mds:MaiaDetector mds:Mythen1k mds:Pilatus100K_S mds:Pilatus100K_S_1000um mds:Pilatus200K mds:Pilatus300K mds:Pilatus3_6M mds:PIXIRAD1 mds:PointGreyFlea3 mds:PrincetonQuadro mds:Retiga4000DC mds:RT41 mds:Vortex90EX mds:XFlashME4_1 mds:XFlashME4_2 ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Analysis method types are mutually exclusive."@en ;
    owl:members ( mds:DiffractionLineProfileAnalysis mds:SinglePeakFitting mds:StrainDecomposition ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Titanium phase types are mutually exclusive."@en ;
    owl:members ( mds:AlphaPrimeTiPhase mds:AlphaTiPhase mds:BetaTiPhase mds:GrainBoundaryAlpha ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Microstructural evolution processes are mutually exclusive as process types, though they may occur concurrently in time."@en ;
    owl:members ( mds:Recovery mds:StressRelief mds:Recrystallization mds:GrainGrowth ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Governing laws are mutually exclusive entities."@en ;
    owl:members ( mds:BraggsLaw mds:AvramiEquation mds:ThermalExpansionRelation mds:VegardsLaw mds:LeverRule ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Heat treatment processes are mutually exclusive - a process cannot be both isothermal and continuous cooling."@en ;
    owl:members ( mds:IsothermalTransformation mds:ContinuousCoolingTransformation mds:BetaTitaniumSolutionization ) .

[] a owl:AllDisjointClasses ;
    owl:members ( mds:BitDepth mds:DetectorLength mds:DetectorName mds:DetectorWidth mds:MaxFrameRate mds:PixelHeight mds:PixelSizeHeight mds:PixelSizeWidth mds:PixelWidth mds:ReadOutTime ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Thermal cycle segments are mutually exclusive - a segment cannot be both heating and cooling."@en ;
    owl:members ( mds:HeatingSegment mds:HoldSegment mds:CoolingSegment ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Temperature types are mutually exclusive based on their functional role."@en ;
    owl:members ( mds:IsothermalHoldTemperature mds:SolutionizationTemperature ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Cooling rate types are mutually exclusive - cannot be both controlled and AFAP."@en ;
    owl:members ( mds:ControlledCoolingRate mds:AsFastAsPossibleCooling ) .

[] a owl:AllDisjointClasses ;
    owl:members ( mds:AttenuatorWheels mds:BeamStop mds:CaveSlit mds:HuberSampleStage mds:Monochromator mds:OpticalTable mds:OpticalTableJack mds:PiezoelectricActuator mds:SafetyBrickAssembly mds:SlitAssembly mds:TungstenRadiationShield mds:Undulator mds:XrayDetector mds:Sample mds:XrayShutter ) .

[] a owl:AllDisjointClasses ;
    owl:members ( mds:BeamConvergence mds:EnergyRange mds:MaxBeamSize mds:WavelengthRange ) .

