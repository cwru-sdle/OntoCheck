    {
      "id": "geospatial-summary-001",
      "level": "contextual_summarization",
      "task_type": "contextual_summary",
      "prompt": "Provide a structured ontology-grounded summary of a sensor.",
      "query": {
        "language": "sparql_summary",
        "sections": [
          {
            "id": "platform",
            "query": "SELECT ?range WHERE { mds:mountedOn rdfs:domain mds:Sensor ; rdfs:range ?range . }"
          },
          {
            "id": "bands",
            "query": "SELECT ?range WHERE { mds:containsBand rdfs:domain mds:Sensor ; rdfs:range ?range . }"
          },
          {
            "id": "owner",
            "query": "SELECT ?range WHERE { mds:ownedByAgency rdfs:domain mds:Sensor ; rdfs:range ?range . }"
          }
        ]
      },
      "expected": {
        "kind": "structured_summary",
        "values": {
          "platform": [
            "mds:Satellite"
          ],
          "bands": [
            "mds:Band"
          ],
          "owner": [
            "mds:Agency"
          ]
        }
      },
      "evidence": {
        "required_claims": [
          "A sensor is mounted on a satellite, collects bands and is owned by an agency."
        ],
        "source_ids": [
          "Geospatial-SatelliteSensorBand.ttl#Sensor"
        ]
      },
