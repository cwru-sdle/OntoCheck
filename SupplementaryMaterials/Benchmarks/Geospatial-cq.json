      "id": "geospatial-retrieval-001",
      "level": "fact_retrieval",
      "task_type": "fact_retrieval",
      "prompt": "What is a sensor such as ASTER mounted on?",
      "query": {
        "language": "sparql",
        "text": "SELECT ?range WHERE { mds:mountedOn rdfs:domain mds:Sensor ; rdfs:range ?range . }"
      },
      "expected": {
        "kind": "result_set",
        "values": [
          "mds:Satellite"
        ]
      },
      "evidence": {
        "required_claims": [
          "A sensor is mounted on a satellite."
        ],
        "source_ids": [
          "Geospatial-SatelliteSensorBand.ttl#Sensor",
          "Geospatial-SatelliteSensorBand.ttl#Satellite"
        ]
      },
      "tags": [
        "relation",
        "fact-retrieval"
      ],
