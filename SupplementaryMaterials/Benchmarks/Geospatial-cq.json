      "id": "geospatial-deduction-001",
      "level": "complex_reasoning",
      "task_type": "deduction",
      "prompt": "Following the class hierarchy, what kind of thing is elevation?",
      "query": {
        "language": "graph_path",
        "source": "mds:Elevation",
        "predicate": "rdfs:subClassOf",
        "min_hops": 1,
        "max_hops": 1
      },
      "expected": {
        "kind": "result_set",
        "values": [
          "mds:GeospatialProperty"
        ]
      },
      "evidence": {
        "required_paths": [
          [
            "mds:Elevation",
            "rdfs:subClassOf",
            "mds:GeospatialProperty"
          ]
        ],
        "required_claims": [
          "Elevation is a geospatial property a raster can contain."
