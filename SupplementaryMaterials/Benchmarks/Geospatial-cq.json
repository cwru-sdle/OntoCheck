    {
      "id": "geospatial-plan-001",
      "level": "constrained_generation",
      "task_type": "constrained_plan",
      "prompt": "Can an ontology-grounded plan select rasters from the Terra satellite at a given spatial resolution within a geohash?",
      "query": {
        "language": "sparql_constraints",
        "checks": [
          {
            "id": "raster-from-satellite",
            "query": "ASK { mds:generatedBySatellite rdfs:domain mds:GeospatialRaster ; rdfs:range mds:Satellite . }"
          },
          {
            "id": "raster-resolution",
            "query": "ASK { mds:hasSpatialResolution rdfs:domain mds:GeospatialRaster ; rdfs:range mds:SpatialResolution . }"
          },
          {
            "id": "raster-geohash",
            "query": "ASK { mds:occupiesSpatialRegion rdfs:domain mds:GeospatialRaster ; rdfs:range mds:Geohash . }"
          },
          {
            "id": "band-from-sensor",
            "query": "ASK { mds:producedBy rdfs:domain mds:Band ; rdfs:range mds:Sensor . }"
          }
        ]
      },
      "expected": {
        "kind": "constraint_checks",
        "values": {
          "raster-from-satellite": "entailed",
          "raster-resolution": "entailed",
          "raster-geohash": "entailed",
          "band-from-sensor": "entailed"
        }
      },
      "evidence": {
        "required_claims": [
          "Rasters link to their satellite, spatial resolution and geohash; bands link to their sensor."
        ],
        "source_ids": [
          "Geospatial-SatelliteSensorBand.ttl#GeospatialRaster"
        ]
      },
      "assumptions": [
        "Ontology assertions constrain the plan but do not by themselves establish that a record exists."
      ],
      "constraints": [
        "Every selected raster must come from the requested satellite and region."
      ],
      "scoring": {
        "answer_weight": 0.0,
        "constraint_weight": 1.0
      },
