  "cases": [
    {
      "id": "ebsd-retrieval-001",
      "level": "fact_retrieval",
      "task_type": "fact_retrieval",
      "prompt": "What equipment is used in the grinding step of a sample's preparation?",
      "query": {
        "language": "sparql",
        "text": "SELECT ?target WHERE { { mds:Grinding rdfs:subClassOf ?r . ?r owl:onProperty mds:usesEquipment ; owl:someValuesFrom ?target . } UNION { mds:usesEquipment rdfs:domain mds:Grinding ; rdfs:range ?target . } FILTER(isIRI(?target)) }"
      },
      "expected": {
        "kind": "result_set",
        "values": [
          "mds:GrindingMachine"
        ]
      },
      "evidence": {
        "required_claims": [
          "Grinding uses a grinding machine."
        ],
        "source_ids": [
          "EBSD.ttl#Grinding",
          "EBSD.ttl#GrindingMachine"
        ]
      },
      "tags": [
        "relation",
        "fact-retrieval"
      ],
      "family_id": "ebsd-grinding",
      "split": "test",
      "leakage_group": "ebsd-grinding",
      "provenance": {
        "sources": [
          "SupplementaryMaterials/Ontologies/EBSD.ttl",
          "SupplementaryMaterials/SPARQL_Queries/EBSD.json#qid=1000008",
          "SupplementaryMaterials/SPARQL_Queries/EBSD.json#qid=1000010",
          "SupplementaryMaterials/SPARQL_Queries/EBSD.json#qid=1000011"
        ],
        "curator": "OntoCheck benchmark team",
        "reviewers": [
          "domain-review-required"
        ]
      }
    },
    {
      "id": "ebsd-deduction-001",
      "level": "complex_reasoning",
      "task_type": "deduction",
      "prompt": "Following the class hierarchy, what kind of process is grinding?",
      "query": {
        "language": "graph_path",
        "source": "mds:Grinding",
        "predicate": "rdfs:subClassOf",
        "min_hops": 1,
        "max_hops": 1
      },
      "expected": {
        "kind": "result_set",
        "values": [
          "mds:MaterialsProcessing"
        ]
      },
      "evidence": {
        "required_paths": [
          [
            "mds:Grinding",
            "rdfs:subClassOf",
            "mds:MaterialsProcessing"
          ]
        ],
        "required_claims": [
          "Grinding is a materials processing step."
        ],
        "source_ids": [
          "EBSD.ttl#Grinding"
        ]
      },
      "scoring": {
        "answer_weight": 0.7,
        "evidence_weight": 0.3
      },
      "tags": [
        "subclass",
        "proof"
      ],
      "family_id": "ebsd-grinding",
      "split": "test",
      "leakage_group": "ebsd-grinding",
