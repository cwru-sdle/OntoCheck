    },
    {
      "id": "ebsd-summary-001",
      "level": "contextual_summarization",
      "task_type": "contextual_summary",
      "prompt": "Provide a structured ontology-grounded summary of the grinding machine.",
      "query": {
        "language": "sparql_summary",
        "sections": [
          {
            "id": "wheel_speed",
            "query": "SELECT ?range WHERE { mds:hasGrindingWheelSpeed rdfs:domain mds:GrindingMachine ; rdfs:range ?range . }"
          },
          {
            "id": "depth_of_cut",
            "query": "SELECT ?range WHERE { mds:hasDepthOfCutPerPass rdfs:domain mds:GrindingMachine ; rdfs:range ?range . }"
          },
          {
            "id": "coolant",
            "query": "SELECT ?range WHERE { mds:deliversCoolant rdfs:domain mds:GrindingMachine ; rdfs:range ?range . }"
          }
        ]
      },
      "expected": {
        "kind": "structured_summary",
        "values": {
          "wheel_speed": [
            "xsd:decimal"
          ],
          "depth_of_cut": [
            "xsd:decimal"
          ],
          "coolant": [
            "mds:GrindingCoolant"
          ]
        }
      },
      "evidence": {
        "required_claims": [
          "The grinding machine records wheel speed and depth of cut per pass, and delivers a grinding coolant."
        ],
        "source_ids": [
          "EBSD.ttl#GrindingMachine"
        ]
      },
      "tags": [
        "structured-summary",
        "equipment"
      ],
      "family_id": "ebsd-grinding",
      "split": "test",
      "leakage_group": "ebsd-grinding",
      "provenance": {
        "sources": [
          "SupplementaryMaterials/Ontologies/EBSD.ttl",
          "SupplementaryMaterials/SPARQL_Queries/EBSD.json#qid=1000010",
          "SupplementaryMaterials/SPARQL_Queries/EBSD.json#qid=1000011",
          "SupplementaryMaterials/SPARQL_Queries/EBSD.json#qid=1000014"
        ],
        "curator": "OntoCheck benchmark team",
        "reviewers": [
          "domain-review-required"
        ]
      }
    },
    {
      "id": "ebsd-plan-001",
      "level": "constrained_generation",
      "task_type": "constrained_plan",
      "prompt": "Can an ontology-grounded plan record the grinding wheel speed and the polishing voltage used to prepare a sample?",
      "query": {
        "language": "sparql_constraints",
        "checks": [
          {
            "id": "sample-undergoes-processing",
            "query": "ASK { mds:undergoesProcessing rdfs:domain mds:Sample ; rdfs:range mds:MaterialsProcessing . }"
          },
          {
            "id": "electropolishing-is-processing",
            "query": "ASK { mds:DryElectropolishing rdfs:subClassOf mds:MaterialsProcessing . }"
          },
          {
            "id": "wheel-speed-on-grinding-machine",
            "query": "ASK { mds:hasGrindingWheelSpeed rdfs:domain mds:GrindingMachine . }"
          },
          {
            "id": "voltage-on-electropolish-system",
            "query": "ASK { mds:hasPolishingVoltage rdfs:domain mds:ElectropolishSystem . }"
          },
          {
            "id": "electropolishing-uses-system",
            "query": "ASK { mds:usesEquipment rdfs:domain mds:DryElectropolishing ; rdfs:range mds:ElectropolishSystem . }"
          }
        ]
      },
      "expected": {
        "kind": "constraint_checks",
        "values": {
          "sample-undergoes-processing": "entailed",
          "electropolishing-is-processing": "entailed",
          "wheel-speed-on-grinding-machine": "entailed",
          "voltage-on-electropolish-system": "entailed",
          "electropolishing-uses-system": "entailed"
        }
      },
      "evidence": {
        "required_claims": [
          "A sample undergoes grinding and dry electropolishing; each step uses equipment whose settings are recorded."
        ],
        "source_ids": [
          "EBSD.ttl#GrindingMachine",
          "EBSD.ttl#ElectropolishSystem"
        ]
      },
      "assumptions": [
        "Ontology assertions constrain the plan but do not by themselves establish that a record exists."
      ],
      "constraints": [
        "Each setting must belong to the equipment of its processing step."
      ],
      "scoring": {
        "answer_weight": 0.0,
        "constraint_weight": 1.0
      },
      "tags": [
        "constrained-plan",
        "processing-chain"
      ],
