    {
      "id": "xrd-plan-001",
      "family_id": "xrd-lpbf-process",
      "level": "constrained_generation",
      "task_type": "constrained_plan",
      "prompt": "Can an ontology-grounded plan select Laser Powder Bed Fusion as an additive manufacturing process associated with rapid solidification?",
      "query": {
        "language": "sparql_constraints",
        "checks": [
          {
            "id": "declared-process-class",
            "query": "ASK { mds:LaserPowderBedFusion a owl:Class . }"
          },
          {
            "id": "additive-manufacturing-classification",
            "query": "ASK { mds:LaserPowderBedFusion rdfs:subClassOf mds:AdditiveManufacturingProcess . }"
          },
          {
            "id": "rapid-solidification-behavior",
            "query": "ASK { mds:LaserPowderBedFusion rdfs:subClassOf ?restriction . ?restriction owl:onProperty mds:has_increased_likelihood_of ; owl:someValuesFrom mds:RapidSolidification . }"
          }
        ]
      },
      "expected": {
        "kind": "constraint_checks",
        "values": {
          "declared-process-class": "entailed",
          "additive-manufacturing-classification": "entailed",
          "rapid-solidification-behavior": "entailed"
        }
      },
      "evidence": {
        "required_claims": [
          "The ontology declares LPBF as an additive manufacturing process.",
          "The ontology associates LPBF with an increased likelihood of rapid solidification."
