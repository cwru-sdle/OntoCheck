      "id": "xrd-retrieval-001",
      "family_id": "xrd-lpbf-process",
      "level": "fact_retrieval",
      "task_type": "fact_retrieval",
      "prompt": "What named process class directly contains Laser Powder Bed Fusion?",
      "query": {
        "language": "sparql",
        "text": "SELECT ?parent WHERE { mds:LaserPowderBedFusion rdfs:subClassOf ?parent . FILTER(isIRI(?parent)) }"
      },
      "expected": {
        "kind": "result_set",
        "values": [
          "mds:AdditiveManufacturingProcess"
        ]
      },
      "evidence": {
        "required_claims": [
          "Laser Powder Bed Fusion is directly classified as an Additive Manufacturing Process."
        ],
        "source_ids": [
          "XRD.ttl#LaserPowderBedFusion"
        ]
