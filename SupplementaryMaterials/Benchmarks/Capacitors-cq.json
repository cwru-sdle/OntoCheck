      "id": "capacitors-retrieval-001",
      "level": "fact_retrieval",
      "task_type": "fact_retrieval",
      "prompt": "Which sensors are part of the exposure chamber?",
      "query": {
        "language": "sparql",
        "text": "SELECT ?part WHERE { { ?part rdfs:subClassOf ?r . ?r owl:onProperty obo:BFO_0000050 ; owl:someValuesFrom mds:ExposureChamber . } UNION { ?part obo:BFO_0000050 mds:ExposureChamber . } }"
      },
      "expected": {
        "kind": "result_set",
        "values": [
          "mds:RelativeHumiditySensor",
          "mds:TypeKThermocouple"
        ]
      },
      "evidence": {
        "required_claims": [
          "The relative humidity sensor and the type K thermocouple are part of the exposure chamber."
        ],
        "source_ids": [
          "Capacitor-Sample.ttl#ExposureChamber"
        ]
      },
      "tags": [
        "parthood",
        "fact-retrieval"
      ],
      "family_id": "capacitor-under-test",
