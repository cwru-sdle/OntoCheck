    {
      "id": "capacitors-plan-001",
      "level": "constrained_generation",
      "task_type": "constrained_plan",
      "prompt": "Can an ontology-grounded plan select a multilayer ceramic capacitor as the sample under test and mount it by soldering?",
      "query": {
        "language": "sparql_constraints",
        "checks": [
          {
            "id": "mlcc-is-capacitor",
            "query": "ASK { mds:MultiLayerCeramicCapacitor rdfs:subClassOf mds:Capacitor . }"
          },
          {
            "id": "capacitor-is-sample",
            "query": "ASK { mds:Capacitor rdfs:subClassOf mds:Sample . }"
          },
          {
            "id": "soldering-declared",
            "query": "ASK { mds:SolderingProcess a owl:Class . }"
          },
          {
            "id": "solder-material-declared",
            "query": "ASK { mds:SolderMaterial a owl:Class . }"
          }
        ]
      },
      "expected": {
        "kind": "constraint_checks",
        "values": {
          "mlcc-is-capacitor": "entailed",
          "capacitor-is-sample": "entailed",
          "soldering-declared": "entailed",
          "solder-material-declared": "entailed"
        }
      },
      "evidence": {
        "required_claims": [
          "The plan's capacitor must be a declared capacitor type that is a sample, mounted with a declared soldering process and solder material."
        ],
        "source_ids": [
          "Capacitor-Sample.ttl#MultiLayerCeramicCapacitor",
          "Capacitor-Sample.ttl#SolderingProcess"
        ]
      },
      "assumptions": [
        "Ontology assertions constrain the plan but do not by themselves establish that a record exists."
      ],
      "constraints": [
        "The selected component must be a capacitor and a sample under test."
      ],
      "scoring": {
        "answer_weight": 0.0,
        "constraint_weight": 1.0
      },
