      "level": "complex_reasoning",
      "task_type": "deduction",
      "prompt": "Following the class hierarchy, what is a multilayer ceramic capacitor two levels up?",
      "query": {
        "language": "graph_path",
        "source": "mds:MultiLayerCeramicCapacitor",
        "predicate": "rdfs:subClassOf",
        "min_hops": 2,
        "max_hops": 2
      },
      "expected": {
        "kind": "result_set",
        "values": [
          "mds:ElectronicComponents"
        ]
      },
      "evidence": {
        "required_paths": [
          [
            "mds:MultiLayerCeramicCapacitor",
            "rdfs:subClassOf",
            "mds:Capacitor",
            "rdfs:subClassOf",
            "mds:ElectronicComponents"
          ]
        ],
        "required_claims": [
          "A multilayer ceramic capacitor is a capacitor.",
          "A capacitor is an electronic component."
        ],
        "source_ids": [
          "Capacitor-Sample.ttl#MultiLayerCeramicCapacitor",
          "Capacitor-Sample.ttl#Capacitor"
        ]
      },
