    {
      "id": "capacitors-summary-001",
      "level": "contextual_summarization",
      "task_type": "contextual_summary",
      "prompt": "Provide a structured ontology-grounded summary of the capacitor under test.",
      "query": {
        "language": "sparql_summary",
        "sections": [
          {
            "id": "capacitance",
            "query": "SELECT ?range WHERE { mds:hasCapacitance rdfs:domain mds:Capacitor ; rdfs:range ?range . }"
          },
          {
            "id": "tolerance",
            "query": "SELECT ?range WHERE { mds:hasTolerance rdfs:domain mds:Capacitor ; rdfs:range ?range . }"
          },
          {
            "id": "voltage_rating",
            "query": "SELECT ?range WHERE { mds:hasVoltageRating rdfs:domain mds:Capacitor ; rdfs:range ?range . }"
          },
          {
            "id": "supplier",
            "query": "SELECT ?range WHERE { mds:hasSupplier rdfs:domain mds:Capacitor ; rdfs:range ?range . }"
          },
          {
            "id": "subtypes",
            "query": "SELECT ?type WHERE { ?type rdfs:subClassOf mds:Capacitor . }"
          }
        ]
      },
      "expected": {
        "kind": "structured_summary",
        "values": {
          "capacitance": [
            "mds:Capacitance"
          ],
          "tolerance": [
            "mds:CapacitanceTolerance"
          ],
          "voltage_rating": [
            "mds:VoltageRating"
          ],
          "supplier": [
            "mds:Supplier"
          ],
          "subtypes": [
            "mds:MultiLayerCeramicCapacitor"
          ]
        }
      },
      "evidence": {
        "required_claims": [
          "A capacitor has a capacitance with a tolerance, a voltage rating and a supplier; a multilayer ceramic capacitor is a kind of capacitor."
        ],
        "source_ids": [
          "Capacitor-Sample.ttl#Capacitor"
        ]
      },
