    {
      "id": "geooutage-deduction-001",
      "level": "complex_reasoning",
      "task_type": "deduction",
      "prompt": "Following the class hierarchy, what kind of entity is an NTL image two levels up?",
      "query": {
        "language": "graph_path",
        "source": "goo:NTLImage",
        "predicate": "rdfs:subClassOf",
        "min_hops": 2,
        "max_hops": 2
      },
      "expected": {
        "kind": "result_set",
        "values": [
          "mds:GeospatialRaster",
          "goo:CountyScopedEntity",
          "goo:SpectralBandScopedEntity"
        ]
      },
      "evidence": {
        "required_paths": [
          [
            "goo:NTLImage",
            "rdfs:subClassOf",
            "goo:SatelliteImage",
            "rdfs:subClassOf",
            "mds:GeospatialRaster"
          ],
          [
            "goo:NTLImage",
            "rdfs:subClassOf",
            "goo:SatelliteImage",
            "rdfs:subClassOf",
            "goo:CountyScopedEntity"
          ],
          [
            "goo:NTLImage",
            "rdfs:subClassOf",
            "goo:SatelliteImage",
            "rdfs:subClassOf",
            "goo:SpectralBandScopedEntity"
          ]
        ],
        "required_claims": [
          "An NTL image is a satellite image.",
          "A satellite image is a county-scoped geospatial raster of spectral bands."
        ],
        "source_ids": [
          "GeoOutage.ttl#NTLImage",
          "GeoOutage.ttl#SatelliteImage"
        ]
      },
      "scoring": {
        "answer_weight": 0.7,
        "evidence_weight": 0.3
      },
