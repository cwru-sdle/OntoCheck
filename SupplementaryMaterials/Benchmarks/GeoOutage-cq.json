    {
      "id": "geooutage-summary-001",
      "level": "contextual_summarization",
      "task_type": "contextual_summary",
      "prompt": "Provide a structured ontology-grounded summary of a customer outage record.",
      "query": {
        "language": "sparql_summary",
        "sections": [
          {
            "id": "outage_count",
            "query": "SELECT ?range WHERE { goo:numberOfOutages rdfs:domain goo:CustomerOutageRecord ; rdfs:range ?range . }"
          },
          {
            "id": "county",
            "query": "SELECT ?place WHERE { goo:CustomerOutageRecord rdfs:subClassOf ?scope . goo:representsCounty rdfs:domain ?scope ; rdfs:range ?place . }"
          }
        ]
      },
      "expected": {
        "kind": "structured_summary",
        "values": {
          "outage_count": [
            "xsd:integer"
          ],
          "county": [
            "goo:County"
          ]
        }
      },
      "evidence": {
        "required_claims": [
          "An outage record counts outages and represents a county."
        ],
        "source_ids": [
          "GeoOutage.ttl#CustomerOutageRecord"
        ]
      },
      "tags": [
        "structured-summary",
        "record"
      ],
      "family_id": "geooutage-county-records",
      "split": "test",
      "leakage_group": "geooutage-county-records",
