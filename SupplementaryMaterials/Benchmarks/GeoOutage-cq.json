  "cases": [
    {
      "id": "geooutage-retrieval-001",
      "level": "fact_retrieval",
      "task_type": "fact_retrieval",
      "prompt": "What kind of place does an outage record, NTL image or outage map represent?",
      "query": {
        "language": "sparql",
        "text": "SELECT ?place WHERE { goo:representsCounty rdfs:range ?place . }"
      },
      "expected": {
        "kind": "result_set",
        "values": [
          "goo:County"
        ]
      },
      "evidence": {
        "required_claims": [
          "Outage records, NTL images and outage maps each represent a county."
        ],
        "source_ids": [
          "GeoOutage.ttl#representsCounty"
        ]
      },
      "tags": [
        "relation",
        "fact-retrieval"
      ],
      "family_id": "geooutage-county-records",
      "split": "test",
      "leakage_group": "geooutage-county-records",
      "provenance": {
