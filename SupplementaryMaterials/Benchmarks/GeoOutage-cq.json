    {
      "id": "geooutage-plan-001",
      "level": "constrained_generation",
      "task_type": "constrained_plan",
      "prompt": "Can an ontology-grounded plan find the NTL image and outage map for the highest-outage record in a county?",
      "query": {
        "language": "sparql_constraints",
        "checks": [
          {
            "id": "record-represents-county",
            "query": "ASK { goo:CustomerOutageRecord rdfs:subClassOf ?scope . goo:representsCounty rdfs:domain ?scope . }"
          },
          {
            "id": "record-counts-outages",
            "query": "ASK { goo:numberOfOutages rdfs:domain goo:CustomerOutageRecord . }"
          },
          {
            "id": "image-has-outage-map",
            "query": "ASK { goo:hasOutageMap rdfs:domain goo:NTLImage ; rdfs:range goo:OutageMap . }"
          },
          {
            "id": "record-links-ntl-image",
            "query": "ASK { ?p rdfs:domain goo:CustomerOutageRecord ; rdfs:range goo:NTLImage . }"
          }
        ]
      },
      "expected": {
        "kind": "constraint_checks",
        "values": {
          "record-represents-county": "entailed",
          "record-counts-outages": "entailed",
          "image-has-outage-map": "entailed",
          "record-links-ntl-image": "entailed"
        }
      },
      "evidence": {
        "required_claims": [
          "A county's outage records, NTL images and outage maps can be joined, and each record links to its NTL image."
        ],
        "source_ids": [
          "GeoOutage.ttl#CustomerOutageRecord",
          "GeoOutage.ttl#NTLImage",
          "GeoOutage.ttl#OutageMap"
        ]
      },
      "assumptions": [
        "Ontology assertions constrain the plan but do not by themselves establish that a record exists."
      ],
      "constraints": [
        "The image and map must belong to the same county as the record."
      ],
      "scoring": {
        "answer_weight": 0.0,
        "constraint_weight": 1.0
      },
      "tags": [
        "constrained-plan",
        "cross-source"
      ],
